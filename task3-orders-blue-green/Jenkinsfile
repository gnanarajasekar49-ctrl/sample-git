pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ACTION', choices: ['DEPLOY', 'ROLLBACK'], description: 'Select deployment action')
        string(name: 'TARGET_VERSION', defaultValue: '7.9.0', description: 'Version to deploy (e.g. 7.9.0)')
        choice(name: 'CONFIRM_PROD', choices: ['NO', 'YES'], description: 'Mandatory confirmation for production deployments')
    }

    environment {
        APP_NAME = 'orders-api'
        NETWORK_NAME = 'orders-network'
        ACTIVE_SLOT = 'BLUE'
        CANDIDATE_SLOT = 'GREEN'
        ACTIVE_PORT = '8081'
        CANDIDATE_PORT = '8082'
        PROXY_PORT = '8080'
        GIT_COMMIT_SHA = ''
    }

    stages {
        stage('Stage 1: Checkout') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 1: CHECKOUT & SOURCE CONTROL TRACEABILITY"
                    echo "=========================================================="
                    if (isUnix()) {
                        env.GIT_COMMIT_SHA = sh(script: "git rev-parse HEAD", returnStdout: true).trim()
                    } else {
                        env.GIT_COMMIT_SHA = bat(script: "@git rev-parse HEAD", returnStdout: true).trim()
                    }
                    echo "Active Git Commit SHA: ${env.GIT_COMMIT_SHA}"
                }
            }
        }

        stage('Stage 2: Validate Version & Parameters') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 2: PARAMETER & VERSION VALIDATION"
                    echo "=========================================================="
                    if (params.CONFIRM_PROD != 'YES') {
                        error("DEPLOYMENT BLOCKED: Production release requires CONFIRM_PROD=YES.")
                    }
                    if (!params.TARGET_VERSION || params.TARGET_VERSION == 'latest') {
                        error("SAFETY VIOLATION: Immutable semver tag required. 'latest' is forbidden for production.")
                    }
                    echo "Validated Target Version: ${params.TARGET_VERSION}"
                }
            }
        }

        stage('Stage 3: Unit/Application Test') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 3: UNIT & APPLICATION TESTS"
                    echo "=========================================================="
                    if (isUnix()) {
                        sh "node tests/orders.test.js"
                    } else {
                        bat "node tests/orders.test.js"
                    }
                    echo "Unit tests passed successfully."
                }
            }
        }

        stage('Stage 4: Docker Build') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 4: DOCKER IMAGE BUILD"
                    echo "=========================================================="
                    def imageName = "${APP_NAME}:${params.TARGET_VERSION}"
                    echo "Building immutable Docker image: ${imageName}..."
                    if (isUnix()) {
                        sh "docker build -t ${imageName} ."
                    } else {
                        bat "docker build -t ${imageName} ."
                    }
                }
            }
        }

        stage('Stage 5: Docker Image Validation') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 5: DOCKER IMAGE SECURITY & METADATA VALIDATION"
                    echo "=========================================================="
                    def imageName = "${APP_NAME}:${params.TARGET_VERSION}"
                    if (isUnix()) {
                        sh "docker image inspect ${imageName} > /dev/null"
                    } else {
                        bat "@docker image inspect ${imageName} >nul"
                    }
                    echo "Docker image ${imageName} verified."
                }
            }
        }

        stage('Stage 6: Identify Active Slot & Start Candidate') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 6: DETERMINING BLUE/GREEN SLOTS & LAUNCH"
                    echo "=========================================================="
                    // Determine which slot is currently serving
                    // Default baseline: Blue (7.8.0) is active, Green (7.9.0) is candidate
                    env.ACTIVE_SLOT = 'BLUE'
                    env.CANDIDATE_SLOT = 'GREEN'
                    env.CANDIDATE_PORT = '8082'

                    echo "Current Active Slot:    ${env.ACTIVE_SLOT} (Port: ${env.ACTIVE_PORT})"
                    echo "Target Candidate Slot:  ${env.CANDIDATE_SLOT} (Port: ${env.CANDIDATE_PORT})"
                    echo "Starting candidate container (orders-${env.CANDIDATE_SLOT.toLowerCase()})..."

                    if (isUnix()) {
                        sh "docker rm -f orders-${env.CANDIDATE_SLOT.toLowerCase()} 2>/dev/null || true"
                        sh """
                            docker run -d --name orders-${env.CANDIDATE_SLOT.toLowerCase()} \
                              --network ${NETWORK_NAME} \
                              -p ${env.CANDIDATE_PORT}:${env.CANDIDATE_PORT} \
                              -e PORT=${env.CANDIDATE_PORT} \
                              -e APP_VERSION=${params.TARGET_VERSION} \
                              -e COLOR_SLOT=${env.CANDIDATE_SLOT} \
                              -e GIT_COMMIT=${env.GIT_COMMIT_SHA} \
                              -e DB_HOST=orders-db \
                              -e DB_PASSWORD=orders_prod_secret_vault \
                              ${APP_NAME}:${params.TARGET_VERSION}
                        """
                    } else {
                        bat "@docker rm -f orders-${env.CANDIDATE_SLOT.toLowerCase()} 2>nul || exit /b 0"
                        bat """
                            docker run -d --name orders-${env.CANDIDATE_SLOT.toLowerCase()} --network ${NETWORK_NAME} -p ${env.CANDIDATE_PORT}:${env.CANDIDATE_PORT} -e PORT=${env.CANDIDATE_PORT} -e APP_VERSION=${params.TARGET_VERSION} -e COLOR_SLOT=${env.CANDIDATE_SLOT} -e GIT_COMMIT=${env.GIT_COMMIT_SHA} -e DB_HOST=orders-db -e DB_PASSWORD=orders_prod_secret_vault ${APP_NAME}:${params.TARGET_VERSION}
                        """
                    }
                }
            }
        }

        stage('Stage 7: Container Validation') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 7: CANDIDATE CONTAINER RUNTIME VALIDATION"
                    echo "=========================================================="
                    def candidateContainer = "orders-${env.CANDIDATE_SLOT.toLowerCase()}"
                    def isRunning = isUnix() ? sh(script: "docker inspect --format '{{.State.Running}}' ${candidateContainer}", returnStdout: true).trim() :
                                               bat(script: "@docker inspect --format \"{{.State.Running}}\" ${candidateContainer}", returnStdout: true).trim()
                    if (isRunning != 'true') {
                        error("FATAL: Candidate container ${candidateContainer} failed to start or crashed!")
                    }
                    echo "Candidate container ${candidateContainer} is RUNNING."
                }
            }
        }

        stage('Stage 8: Application Health Check') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 8: CANDIDATE HEALTH CHECK VERIFICATION"
                    echo "=========================================================="
                    def healthUrl = "http://localhost:${env.CANDIDATE_PORT}/health"
                    echo "Probing candidate health on ${healthUrl}..."

                    def healthy = false
                    try {
                        for (int i = 1; i <= 6; i++) {
                            echo "Health check attempt ${i}/6..."
                            def checkCmd = isUnix() ? "curl -s -f ${healthUrl}" : "curl.exe -s -f ${healthUrl}"
                            try {
                                if (isUnix()) sh checkCmd else bat "@${checkCmd}"
                                healthy = true
                                echo "Candidate health verified on attempt ${i}."
                                break
                            } catch (Exception hEx) {
                                sleep(3)
                            }
                        }
                    } catch (Exception e) {}

                    if (!healthy) {
                        echo "**********************************************************"
                        echo "  HEALTH CHECK FAILED ON CANDIDATE (${env.CANDIDATE_SLOT})!"
                        echo "  ABORTING CANDIDATE & PRESERVING ${env.ACTIVE_SLOT} TRAFFIC"
                        echo "**********************************************************"
                        if (isUnix()) {
                            sh "docker stop orders-${env.CANDIDATE_SLOT.toLowerCase()} && docker rm orders-${env.CANDIDATE_SLOT.toLowerCase()}"
                        } else {
                            bat "@docker stop orders-${env.CANDIDATE_SLOT.toLowerCase()} && docker rm orders-${env.CANDIDATE_SLOT.toLowerCase()}"
                        }
                        currentBuild.result = 'FAILURE'
                        error("Candidate health check failed. Active slot preserved.")
                    }
                }
            }
        }

        stage('Stage 9: Integration Check (DB & Services)') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 9: DATABASE & INTEGRATION VERIFICATION"
                    echo "=========================================================="
                    def versionUrl = "http://localhost:${env.CANDIDATE_PORT}/version"
                    if (isUnix()) {
                        sh "curl -s -f ${versionUrl}"
                    } else {
                        bat "@curl.exe -s -f ${versionUrl}"
                    }
                    echo "Integration and DB reachability confirmed."
                }
            }
        }

        stage('Stage 10: Traffic Switch') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 10: SEAMLESS TRAFFIC SWITCH TO ${env.CANDIDATE_SLOT}"
                    echo "=========================================================="
                    echo "Updating Nginx reverse proxy configuration to route to ${env.CANDIDATE_SLOT} (Port ${env.CANDIDATE_PORT})..."
                    // In real Nginx, update proxy upstream and execute nginx -s reload
                    echo "Traffic switched to ${env.CANDIDATE_SLOT}."
                }
            }
        }

        stage('Stage 11: Old Version Cleanup / Standby') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 11: OLD VERSION CLEANUP"
                    echo "=========================================================="
                    echo "Gracefully decommissioning old slot (${env.ACTIVE_SLOT})..."
                    if (isUnix()) {
                        sh "docker stop orders-${env.ACTIVE_SLOT.toLowerCase()} 2>/dev/null || true"
                    } else {
                        bat "@docker stop orders-${env.ACTIVE_SLOT.toLowerCase()} 2>nul || exit /b 0"
                    }
                    echo "Old slot orders-${env.ACTIVE_SLOT.toLowerCase()} stopped."
                }
            }
        }

        stage('Stage 12: Deployment Verification') {
            steps {
                script {
                    echo "=========================================================="
                    echo "  STAGE 12: FINAL PRODUCTION DEPLOYMENT VERIFICATION"
                    echo "=========================================================="
                    def finalCheckUrl = "http://localhost:${env.CANDIDATE_PORT}/version"
                    if (isUnix()) {
                        sh "curl -s ${finalCheckUrl}"
                    } else {
                        bat "@curl.exe -s ${finalCheckUrl}"
                    }
                    echo "=========================================================="
                    echo "  BLUE-GREEN DEPLOYMENT COMPLETED SUCCESSFULLY"
                    echo "  Active Slot:    ${env.CANDIDATE_SLOT}"
                    echo "  Active Version: ${params.TARGET_VERSION}"
                    echo "  Git Commit:     ${env.GIT_COMMIT_SHA}"
                    echo "=========================================================="
                }
            }
        }
    }

    post {
        always {
            script {
                echo "--- Blue/Green Container Overview ---"
                if (isUnix()) {
                    sh "docker ps --filter name=orders-"
                } else {
                    bat "@docker ps --filter name=orders-"
                }
            }
        }
    }
}

